# Copy to .env for local development. Replace every example value.
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string, including the database name
DB_URL=mongodb+srv://username:password@cluster.example.mongodb.net/peercode

# Clerk backend authentication
CLERK_SECRET_KEY=sk_test_replace_me

# Stream server credentials (keep the secret on the server only)
STREAM_API_KEY=replace_with_stream_api_key
STREAM_API_SECRET=replace_with_stream_api_secret

# Judge0 CE via RapidAPI (keep this key on the backend only)
JUDGE0_RAPIDAPI_KEY=replace_with_rapidapi_key
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Allowed browser origin; use your Vercel site origin in production
CLIENT_URL=http://localhost:5173

# Inngest keys are needed for Clerk user lifecycle sync jobs
INNGEST_EVENT_KEY=replace_with_inngest_event_key
INNGEST_SIGNING_KEY=replace_with_inngest_signing_key
